                            "raw": "{{baseUrl}}/timeline/active/8?academicYear=2024-2025",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "timeline",
                                "active",
                                "8"
                            ],
                            "query": [
                                {
                                    "key": "academicYear",
                                    "value": "2024-2025"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Check Phase Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/timeline/check-phase/groupFormation?academicYear=2024-2025&semester=8",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "timeline",
                                "check-phase",
                                "groupFormation"
                            ],
                            "query": [
                                {
                                    "key": "academicYear",
                                    "value": "2024-2025"
